<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Arirang Concert Checklist 🪭</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-void: #070304;
      --bg-card: rgba(22, 9, 12, 0.88);
      --crimson-deep: #5e0610;
      --crimson: #c8102e;
      --crimson-bright: #ff2442;
      --gold: #f0c26b;
      --gold-soft: rgba(240, 194, 107, 0.28);
      --text-main: #fff6f7;
      --text-dim: #b49399;
      --border-glass: rgba(240, 194, 107, 0.24);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Prompt', sans-serif;
    }

    body {
      min-height: 100vh;
      background-color: var(--bg-void);
      background-image:
        radial-gradient(circle at 12% 10%, rgba(200, 16, 46, 0.28) 0%, transparent 42%),
        radial-gradient(circle at 88% 20%, rgba(240, 194, 107, 0.10) 0%, transparent 38%),
        radial-gradient(circle at 50% 95%, rgba(94, 6, 16, 0.55) 0%, transparent 55%);
      color: var(--text-main);
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 28px 14px 48px;
      overflow-x: hidden;
    }

    /* ลายฉลุพื้นหลังจางๆ */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: radial-gradient(rgba(240, 194, 107, 0.06) 1px, transparent 1px);
      background-size: 24px 24px;
      pointer-events: none;
      z-index: 0;
    }

    .app-shell {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 500px;
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass);
      border-radius: 28px;
      padding: 26px 20px 22px;
      box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.85),
        0 0 35px rgba(200, 16, 46, 0.22),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    /* กรอบทองด้านในบางๆ */
    .app-shell::after {
      content: "";
      position: absolute;
      inset: 7px;
      border-radius: 21px;
      border: 1px solid rgba(240, 194, 107, 0.09);
      pointer-events: none;
    }

    /* พัดจีนมุมขวาบน */
    .fan-wrap {
      position: absolute;
      top: -18px;
      right: -18px;
      width: 168px;
      height: 168px;
      pointer-events: none;
      z-index: 2;
      filter: drop-shadow(0 8px 18px rgba(200, 16, 46, 0.45));
      transform-origin: 100px 145px;
      animation: gentleBreeze 5.5s ease-in-out infinite;
    }

    @keyframes gentleBreeze {
      0%, 100% { transform: rotate(-10deg); }
      50% { transform: rotate(-2deg); }
    }

    /* ส่วนหัว */
    .header {
      position: relative;
      z-index: 3;
      padding-right: 105px;
      margin-bottom: 18px;
    }

    .kr-sub {
      font-family: 'Noto Serif KR', serif;
      font-size: 12px;
      letter-spacing: 3px;
      color: var(--gold);
      opacity: 0.9;
      margin-bottom: 4px;
    }

    .tag-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.8px;
      color: #ffd9e0;
      background: linear-gradient(90deg, rgba(200, 16, 46, 0.65), rgba(94, 6, 16, 0.75));
      border: 1px solid rgba(240, 194, 107, 0.4);
      padding: 4px 11px;
      border-radius: 999px;
      margin-bottom: 10px;
    }

    .dot-live {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 8px var(--gold);
      animation: pulseDot 1.8s infinite;
    }

    @keyframes pulseDot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.45; transform: scale(0.8); }
    }

    h1 {
      font-size: 22px;
      font-weight: 700;
      line-height: 1.3;
      background: linear-gradient(120deg, #ffffff 10%, #ffe3e7 55%, var(--gold) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* การ์ดความคืบหน้า */
    .progress-card {
      position: relative;
      z-index: 3;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.04), rgba(200, 16, 46, 0.08));
      border: 1px solid rgba(240, 194, 107, 0.22);
      border-radius: 18px;
      padding: 14px 16px;
      margin-bottom: 16px;
    }

    .progress-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      font-size: 13px;
    }

    .progress-label {
      color: var(--text-dim);
      font-weight: 400;
    }

    .progress-stat {
      color: var(--gold);
      font-weight: 600;
    }

    .track {
      width: 100%;
      height: 10px;
      background: rgba(0, 0, 0, 0.55);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      background: linear-gradient(90deg, #8f081b, var(--crimson-bright), var(--gold));
      box-shadow: 0 0 14px rgba(255, 36, 66, 0.65);
      transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .ready-banner {
      margin-top: 10px;
      font-size: 12px;
      color: var(--gold);
      display: none;
      align-items: center;
      gap: 6px;
    }

    .ready-banner.show {
      display: flex;
    }

    /* ช่องเพิ่มของ */
    .composer {
      position: relative;
      z-index: 3;
      display: flex;
      gap: 8px;
      margin-bottom: 14px;
    }

    .composer input {
      flex: 1;
      background: rgba(8, 3, 5, 0.72);
      border: 1px solid rgba(240, 194, 107, 0.28);
      border-radius: 14px;
      padding: 11px 14px;
      color: var(--text-main);
      font-size: 14px;
      outline: none;
      transition: all 0.2s;
    }

    .composer input::placeholder {
      color: #8c6d73;
    }

    .composer input:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(240, 194, 107, 0.14);
    }

    .btn-add {
      background: linear-gradient(135deg, var(--crimson-bright), var(--crimson-deep));
      color: #fff;
      border: 1px solid rgba(240, 194, 107, 0.65);
      border-radius: 14px;
      padding: 0 18px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.2s ease;
      white-space: nowrap;
    }

    .btn-add:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(255, 36, 66, 0.45);
    }

    .btn-add:active {
      transform: scale(0.97);
    }

    /* แถบฟิลเตอร์ & เครื่องมือ */
    .toolbar {
      position: relative;
      z-index: 3;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }

    .filters {
      display: flex;
      background: rgba(0, 0, 0, 0.45);
      padding: 3px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .filter-btn {
      background: transparent;
      border: none;
      color: var(--text-dim);
      font-size: 12px;
      padding: 6px 11px;
      border-radius: 9px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .filter-btn.active {
      background: linear-gradient(135deg, var(--crimson), #7d0917);
      color: #fff;
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(200, 16, 46, 0.4);
    }

    .mini-actions {
      display: flex;
      gap: 6px;
    }

    .icon-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(240, 194, 107, 0.22);
      color: var(--gold);
      font-size: 12px;
      padding: 6px 10px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .icon-btn:hover {
      background: rgba(240, 194, 107, 0.14);
    }

    /* รายการ To-Do */
    .checklist {
      position: relative;
      z-index: 3;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: 420px;
      overflow-y: auto;
      padding-right: 2px;
    }

    .checklist::-webkit-scrollbar {
      width: 5px;
    }
    .checklist::-webkit-scrollbar-thumb {
      background: rgba(240, 194, 107, 0.25);
      border-radius: 99px;
    }

    .item-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 14px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 36, 66, 0.28);
      cursor: pointer;
      transition: all 0.22s ease;
      user-select: none;
    }

    .item-card:hover {
      transform: translateX(3px);
      border-color: rgba(240, 194, 107, 0.55);
      background: rgba(200, 16, 46, 0.12);
    }

    .item-card.done {
      background: rgba(10, 4, 6, 0.65);
      border-color: rgba(240, 194, 107, 0.14);
    }

    .item-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      flex: 1;
    }

    .check-box {
      width: 24px;
      height: 24px;
      border-radius: 8px;
      border: 2px solid var(--crimson-bright);
      background: rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }

    .item-card.done .check-box {
      background: linear-gradient(135deg, var(--crimson-bright), var(--crimson-deep));
      border-color: var(--gold);
    }

    .check-box svg {
      width: 14px;
      height: 14px;
      stroke: var(--gold);
      stroke-width: 3;
      fill: none;
      opacity: 0;
      transform: scale(0.4);
      transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .item-card.done .check-box svg {
      opacity: 1;
      transform: scale(1);
    }

    .item-title {
      font-size: 14.5px;
      font-weight: 400;
      color: var(--text-main);
      word-break: break-word;
      transition: all 0.2s;
    }

    .item-card.done .item-title {
      text-decoration: line-through;
      color: var(--text-dim);
    }

    .item-right {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .badge-status {
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 999px;
      transition: all 0.2s;
    }

    .item-card:not(.done) .badge-status {
      background: rgba(255, 36, 66, 0.16);
      color: #ff8696;
      border: 1px solid rgba(255, 36, 66, 0.35);
    }

    .item-card.done .badge-status {
      background: rgba(240, 194, 107, 0.16);
      color: var(--gold);
      border: 1px solid rgba(240, 194, 107, 0.42);
    }

    .del-btn {
      background: transparent;
      border: none;
      color: #8b6870;
      font-size: 14px;
      padding: 4px 6px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .del-btn:hover {
      color: #ff4d64;
      background: rgba(255, 36, 66, 0.14);
    }

    .empty-state {
      text-align: center;
      padding: 34px 16px;
      color: var(--text-dim);
      font-size: 13.5px;
    }

    /* Toast แจ้งเตือน */
    .toast {
      position: fixed;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: rgba(28, 10, 14, 0.95);
      border: 1px solid var(--gold);
      color: var(--text-main);
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 13px;
      opacity: 0;
      pointer-events: none;
      transition: all 0.28s ease;
      z-index: 99;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .footer-wave {
      position: relative;
      z-index: 2;
      margin-top: 18px;
      opacity: 0.55;
    }
  </style>
</head>
<body>
  <main class="app-shell">
    <!-- พัดจีนตกแต่งมุมบนขวา -->
    <svg class="fan-wrap" viewBox="0 0 220 220" aria-hidden="true">
      <defs>
        <linearGradient id="silkRed" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ff2b47"/>
          <stop offset="55%" stop-color="#b80d28"/>
          <stop offset="100%" stop-color="#47040c"/>
        </linearGradient>
      </defs>
      <!-- พู่ห้อยทอง -->
      <line x1="115" y1="162" x2="115" y2="196" stroke="#f0c26b" stroke-width="2.5"/>
      <circle cx="115" cy="198" r="4.5" fill="#f0c26b"/>
      <!-- ใบพัดจีบ -->
      <path d="M 115 162 L 24 84 A 122 122 0 0 1 202 80 Z" fill="url(#silkRed)" stroke="#f0c26b" stroke-width="2.5"/>
      <!-- ซี่พัด -->
      <g stroke="#f0c26b" stroke-width="1.2" opacity="0.8">
        <line x1="115" y1="162" x2="45" y2="66"/>
        <line x1="115" y1="162" x2="72" y2="50"/>
        <line x1="115" y1="162" x2="102" y2="42"/>
        <line x1="115" y1="162" x2="132" y2="42"/>
        <line x1="115" y1="162" x2="160" y2="50"/>
        <line x1="115" y1="162" x2="185" y2="66"/>
      </g>
      <!-- ลวดลายดอกไม้ทอง -->
      <circle cx="115" cy="86" r="6" fill="#f0c26b"/>
      <circle cx="84" cy="96" r="4" fill="#f0c26b" opacity="0.8"/>
      <circle cx="146" cy="96" r="4" fill="#f0c26b" opacity="0.8"/>
      <!-- หมุดยึดด้ามพัด -->
      <circle cx="115" cy="162" r="7" fill="#f0c26b" stroke="#5e0610" stroke-width="2"/>
    </svg>

    <header class="header">
      <div class="kr-sub">아리랑 · ARIRANG</div>
      <div class="tag-pill">
        <span class="dot-live"></span>
        <span>CONCERT PACKING LIST</span>
      </div>
      <h1 id="boardTitle">เช็กลิสต์ของไปคอน</h1>
    </header>

    <section class="progress-card">
      <div class="progress-top">
        <span class="progress-label">เตรียมของครบหรือยัง</span>
        <span class="progress-stat" id="progressStat">0 / 0 (0%)</span>
      </div>
      <div class="track">
        <div class="fill" id="progressFill"></div>
      </div>
      <div class="ready-banner" id="readyBanner">
        <span>🪭</span>
        <span>ครบ 100% แล้ว! พร้อมไปสนุกหน้าฮอลล์แบบปังๆ</span>
      </div>
    </section>

    <div class="composer">
      <input type="text" id="itemInput" placeholder="พิมพ์ของที่ต้องเอาไปคอน..." onkeydown="if(event.key==='Enter') addItem()" />
      <button class="btn-add" onclick="addItem()">+ เพิ่ม</button>
    </div>

    <div class="toolbar">
      <div class="filters">
        <button class="filter-btn active" data-filter="all" onclick="setFilter('all', this)">ทั้งหมด</button>
        <button class="filter-btn" data-filter="pending" onclick="setFilter('pending', this)">ยังไม่เอาไป</button>
        <button class="filter-btn" data-filter="done" onclick="setFilter('done', this)">เอาไปแล้ว</button>
      </div>
      <div class="mini-actions">
        <button class="icon-btn" onclick="copyList()" title="คัดลอกลิสต์">คัดลอก</button>
        <button class="icon-btn" onclick="resetChecks()" title="ล้างเครื่องหมายติ๊ก">รีเซ็ต</button>
      </div>
    </div>

    <ul class="checklist" id="checklist"></ul>

    <svg class="footer-wave" viewBox="0 0 440 24" width="100%" height="24" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 10 Q 22 0, 44 10 T 88 10 T 132 10 T 176 10 T 220 10 T 264 10 T 308 10 T 352 10 T 396 10 T 440 10" fill="none" stroke="#f0c26b" stroke-width="1.6"/>
      <path d="M0 17 Q 22 7, 44 17 T 88 17 T 132 17 T 176 17 T 220 17 T 264 17 T 308 17 T 352 17 T 396 17 T 440 17" fill="none" stroke="#ff2442" stroke-width="1.6"/>
    </svg>
  </main>

  <div class="toast" id="toast"></div>

  <script>
    // =========================================================================
    // [ตัวเลือกเสริม] ถ้าต้องการดึง "หัวตารางคอลัมน์ A1" และ "รายการเริ่มต้นคอลัมน์ A2:A"
    // จาก Google Apps Script Web App ให้วาง URL ลงใน SHEET_API_URL ด้านล่างครับ
    // ถ้าเว้นว่าง "" ไว้ จะใช้รายการตัวอย่างตั้งต้นและเก็บข้อมูลในเครื่อง (localStorage) ทันที
    // =========================================================================
    const SHEET_API_URL = "";
    const STORAGE_KEY = "arirang_concert_todo_v1";

    const DEFAULT_ITEMS = [
      { id: 1, name: "บัตรคอนเสิร์ต / บัตรประชาชน", done: false },
      { id: 2, name: "แท่งไฟ + ถ่านสำรอง", done: false },
      { id: 3, name: "พาวเวอร์แบงก์ + สายชาร์จ", done: false },
      { id: 4, name: "พัดจีน / พัดมือคลายร้อน", done: false },
      { id: 5, name: "ยาดม / ลูกอม / ทิชชู่เปียก", done: false },
      { id: 6, name: "กระเป๋าคาดลำตัว / ถุงซิปล็อก", done: false }
    ];

    let state = {
      title: "เช็กลิสต์ของไปคอน",
      filter: "all",
      items: []
    };

    function loadState() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          state.title = parsed.title || state.title;
          state.items = Array.isArray(parsed.items) ? parsed.items : [...DEFAULT_ITEMS];
        } catch {
          state.items = [...DEFAULT_ITEMS];
        }
      } else {
        state.items = [...DEFAULT_ITEMS];
      }
      render();

      // หากตั้งค่า SHEET_API_URL ไว้ ให้ลองดึงหัวตารางและรายการจากชีต1
      if (SHEET_API_URL) {
        fetch(SHEET_API_URL)
          .then(res => res.json())
          .then(data => {
            if (data && data.header) {
              state.title = data.header;
            }
            if (!saved && Array.isArray(data.items) && data.items.length > 0) {
              state.items = data.items.map((name, idx) => ({
                id: Date.now() + idx,
                name,
                done: false
              }));
            }
            saveState();
            render();
          })
          .catch(() => showToast("ดึงข้อมูลจากชีตไม่สำเร็จ ใช้ลิสต์ในเครื่องแทนนะ"));
      }
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        title: state.title,
        items: state.items
      }));
    }

    function addItem() {
      const input = document.getElementById("itemInput");
      const text = input.value.trim();
      if (!text) {
        showToast("พิมพ์ชื่อสิ่งของก่อนนะ");
        input.focus();
        return;
      }

      state.items.push({
        id: Date.now() + Math.random(),
        name: text,
        done: false
      });

      input.value = "";
      saveState();
      render();
      showToast("เพิ่มรายการเรียบร้อย");
    }

    function toggleItem(id) {
      const target = state.items.find(i => i.id === id);
      if (!target) return;
      target.done = !target.done;
      saveState();
      render();
    }

    function deleteItem(event, id) {
      event.stopPropagation();
      state.items = state.items.filter(i => i.id !== id);
      saveState();
      render();
      showToast("ลบรายการแล้ว");
    }

    function setFilter(filterName, btnEl) {
      state.filter = filterName;
      document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
      if (btnEl) btnEl.classList.add("active");
      render();
    }

    function resetChecks() {
      if (state.items.length === 0) return;
      state.items.forEach(i => i.done = false);
      saveState();
      render();
      showToast("รีเซ็ตสถานะทั้งหมดแล้ว");
    }

    function copyList() {
      if (state.items.length === 0) {
        showToast("ยังไม่มีรายการให้คัดลอก");
        return;
      }
      const lines = state.items.map(i => `${i.done ? "☑" : "☐"} ${i.name} (${i.done ? "เอาไปแล้ว" : "ยังไม่ได้เอาไป"})`);
      const output = `🪭 ${state.title}\n` + lines.join("\n");
      navigator.clipboard.writeText(output)
        .then(() => showToast("คัดลอกลิสต์ไปวางต่อได้เลย!"))
        .catch(() => showToast("คัดลอกไม่สำเร็จ ลองอีกครั้งนะ"));
    }

    function render() {
      document.getElementById("boardTitle").textContent = state.title;

      const listEl = document.getElementById("checklist");
      const filtered = state.items.filter(item => {
        if (state.filter === "pending") return !item.done;
        if (state.filter === "done") return item.done;
        return true;
      });

      listEl.innerHTML = "";

      if (filtered.length === 0) {
        listEl.innerHTML = `<div class="empty-state">ไม่มีรายการในหมวดนี้ ลองเพิ่มของใหม่หรือเปลี่ยนตัวกรองดูนะ</div>`;
      } else {
        filtered.forEach(item => {
          const li = document.createElement("li");
          li.className = "item-card" + (item.done ? " done" : "");
          li.onclick = () => toggleItem(item.id);

          li.innerHTML = `
            <div class="item-left">
              <div class="check-box">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <span class="item-title">${escapeHtml(item.name)}</span>
            </div>
            <div class="item-right">
              <span class="badge-status">${item.done ? "เอาไปแล้ว" : "ยังไม่ได้เอาไป"}</span>
              <button class="del-btn" title="ลบรายการ" onclick="deleteItem(event, ${item.id})">✕</button>
            </div>
          `;
          listEl.appendChild(li);
        });
      }

      updateProgress();
    }

    function updateProgress() {
      const total = state.items.length;
      const doneCount = state.items.filter(i => i.done).length;
      const pct = total === 0 ? 0 : Math.round((doneCount / total) * 100);

      document.getElementById("progressStat").textContent = `${doneCount} / ${total} (${pct}%)`;
      document.getElementById("progressFill").style.width = `${pct}%`;

      const readyBanner = document.getElementById("readyBanner");
      if (total > 0 && doneCount === total) {
        readyBanner.classList.add("show");
      } else {
        readyBanner.classList.remove("show");
      }
    }

    let toastTimer;
    function showToast(msg) {
      const toast = document.getElementById("toast");
      toast.textContent = msg;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
    }

    function escapeHtml(str) {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    loadState();
  </script>
</body>
</html>
